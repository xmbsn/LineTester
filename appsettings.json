{
  "ListenPort": 8800,
  "IntervalMs": 1000,
  "TimeoutMs": 1000,
  "WarningRttMs": 300,
  "StatWindowMinutes": 60,
  "LossWarnPercent": 1.0,
  "ConsecutiveLossWarn": 3,
  "EnableTcp": true,
  "EnableUdp": true,
  // ICMP（ping）默认关闭：部分机房/防火墙禁 ping，需要时再打开。不需要对端装本软件，也不需要管理员权限。
  // 精度 1 毫秒（TCP/UDP 是亚毫秒），且没有端口概念；详见 README「ICMP 探测」。
  "EnableIcmp": false,
  "Links": [
    {
      "Name": "本机9001",
      "Host": "127.0.0.1",
      "Port": 9001,
      "Tcp": true,
      "Udp": true,
      // 链路级 ICMP 开关：全局与链路都打开才会发 ping 包。
      "Icmp": false
    }
  ],

  // 多机房自动互测（注册中心）。Enabled=false 时行为与升级前完全一致。
  // 每个节点只填“自己 + 中心”，链路会自动生成/删除；详细填法与注意事项见 README「多机房自动互测」。
  "Registrar": {
    "Enabled": false,
    "ServeAsCenter": false,
    "NodeName": "",
    "PublicHost": "",        // 本端外网地址（机房映射进来的地址，必须手工填）
    "PublicPort": 0,         // 本端外网端口（机房映射进来的那个端口）
    "Distributable": true,   // 是否允许自己被分发给其他节点
    "AdvertiseTcp": true,    // 是否宣告“可被 TCP 探测”（机房只映射 UDP 就关掉）
    "AdvertiseUdp": true,
    "AdvertiseIcmp": false,  // 是否宣告“可被 ICMP ping”（默认关；对端禁 ping 时被探测会一直超时）
    "CenterHost": "",        // 注册中心的外网地址；中心与本机同机时可填 127.0.0.1
    "CenterPort": 0,
    "Secret": "",            // 预共享密钥，各节点与中心必须一致（可留空，但会标记“无密钥”）
    "HeartbeatSeconds": 60,
    "SyncSeconds": 300,
    "RetryMs": 1000,
    "MaxRetries": 5
  },

  // 运营商信息查询（判断是否跨运营商测试）。默认开启；关掉后一个字节都不会往外发。
  // 免费接口只支持 HTTP 明文、15 次/分钟，因此只查公网地址、结果缓存 CacheDays 天。
  "Isp": {
    "Enabled": true,
    "Endpoint": "http://ip-api.com/batch",
    "CacheDays": 30,
    "TimeoutMs": 5000
  }
}
