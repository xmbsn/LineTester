<UserControl x:Class="LineTester.Views.RttChartPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LineTester.Views"
             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Grid Margin="0,6,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 时间范围 -->
            <RowDefinition Height="Auto"/>   <!-- 范围文案 -->
            <RowDefinition Height="*"/>      <!-- 曲线 -->
            <RowDefinition Height="Auto"/>   <!-- 图例 -->
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="#3C4043" Text="时间范围"/>
            <ComboBox x:Name="RangeBox" DockPanel.Dock="Left" Width="150" Height="26"
                      VerticalContentAlignment="Center" SelectionChanged="RangeBox_Changed">
                <ComboBoxItem Content="最近 24 小时"/>
                <ComboBoxItem Content="本会话（实时）"/>
                <ComboBoxItem Content="今天"/>
                <ComboBoxItem Content="昨天"/>
                <ComboBoxItem Content="指定日期…"/>
            </ComboBox>

            <DatePicker x:Name="DayPicker" DockPanel.Dock="Left" Width="126" Height="26" Margin="8,0,0,0"
                        IsEnabled="False" SelectedDateChanged="DayPicker_Changed"
                        ToolTip="选一天看那一天的曲线（数据来自 logs\日期\ 下的 CSV 日志）"/>

            <Button x:Name="ReloadButton" DockPanel.Dock="Left" Content="刷新" Margin="8,0,0,0"
                    Padding="12,4" MinWidth="60" Click="Reload_Click"
                    ToolTip="重新读取日志（历史范围本身也会自动跟随新增数据）"/>

            <Button x:Name="ResetViewButton" DockPanel.Dock="Left" Content="全览" Margin="8,0,0,0"
                    Padding="12,4" MinWidth="60" Click="ResetView_Click"
                    ToolTip="回到当前范围的全程（在图上双击也一样）"/>

            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#5F6368"
                       Text="滚轮缩放（以鼠标位置为锚点）· 左键拖拽平移 · 双击全览 · 悬停看同一时刻各曲线取值"/>
        </DockPanel>

        <TextBlock x:Name="RangeText" Grid.Row="1" Margin="0,0,0,6" Foreground="#3C4043"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="2" Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="6">
            <views:RttChart x:Name="Chart" Margin="1"/>
        </Border>

        <ItemsControl Grid.Row="3" x:Name="Legend" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- 图例即筛选器：点一下隐藏/显示对应曲线（成熟图表的通用做法） -->
                    <Border Margin="0,0,8,6" Padding="7,3" CornerRadius="3" Cursor="Hand"
                            Background="#F1F3F4" ToolTip="点击显示 / 隐藏这条曲线"
                            MouseLeftButtonUp="LegendItem_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hidden}" Value="True">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                       VerticalAlignment="Center" Fill="{Binding Brush}"/>
                            <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="#202124">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Hidden}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
