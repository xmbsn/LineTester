<UserControl x:Class="LineTester.Views.RttChartPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LineTester.Views"
             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Grid Margin="0,6,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 工具条 -->
            <RowDefinition Height="*"/>      <!-- 曲线 -->
            <RowDefinition Height="Auto"/>   <!-- 图例 -->
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
            <Button x:Name="ResetViewButton" DockPanel.Dock="Left" Content="全览"
                    Padding="12,4" MinWidth="64" Click="ResetView_Click"
                    ToolTip="回到会话全程（在图上双击也一样）"/>

            <TextBlock x:Name="RangeText" DockPanel.Dock="Left" Margin="12,0,0,0"
                       VerticalAlignment="Center" Foreground="#3C4043"/>

            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#5F6368"
                       Text="滚轮缩放（以鼠标位置为锚点）· 左键拖拽平移 · 双击回到全程 · 悬停看同一时刻各曲线取值"/>
        </DockPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="6">
            <views:RttChart x:Name="Chart" Margin="1"/>
        </Border>

        <ItemsControl Grid.Row="2" x:Name="Legend" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- 图例即筛选器：点一下隐藏/显示对应曲线（成熟图表的通用做法） -->
                    <Border Margin="0,0,8,6" Padding="7,3" CornerRadius="3" Cursor="Hand"
                            Background="#F1F3F4" ToolTip="点击显示 / 隐藏这条曲线"
                            MouseLeftButtonUp="LegendItem_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hidden}" Value="True">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                       VerticalAlignment="Center" Fill="{Binding Brush}"/>
                            <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="#202124">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Hidden}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
