<Window x:Class="LineTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LineTester.Views"
        Title="机房线路稳定性测试工具" Height="880" Width="1360"
        MinHeight="660" MinWidth="1120"
        Background="#F5F6F8"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <!-- 参数标签与输入框 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#3C4043"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
        </Style>
        <Style x:Key="FieldCheck" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#202124"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <!-- 按钮：自绘模板，保证 hover/pressed 在三套主题下都一致 -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Foreground" Value="#202124"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F3F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8EAED"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 所有按钮默认套用基础外观（含圆角与内边距） -->
        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1A73E8"/>
            <Setter Property="BorderBrush" Value="#1A73E8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1666CC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1666CC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12559F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#12559F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表格统一外观 -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F2"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F6F8"/>
            <Setter Property="Foreground" Value="#3C4043"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- 隔行底纹用行样式实现，避免与"非法行标红"的行样式互相覆盖 -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 数值列：右对齐 -->
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="NumberHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F6F8"/>
            <Setter Property="Foreground" Value="#3C4043"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 本机节点名称（大号） -->
            <RowDefinition Height="Auto"/>   <!-- 参数 -->
            <RowDefinition Height="Auto"/>   <!-- 操作 -->
            <RowDefinition Height="Auto"/>   <!-- 状态 -->
            <RowDefinition Height="*"/>      <!-- 表格 -->
            <RowDefinition Height="Auto"/>   <!-- 说明 -->
        </Grid.RowDefinitions>

        <!-- ===== 本机节点名称（大号）：同机开多个实例时一眼认出这台是哪台 ===== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="本机节点"
                           Margin="0,0,10,0" FontSize="14" Foreground="#5F6368"/>

                <TextBlock Grid.Column="1" x:Name="NodeNameText" Text="未命名节点"
                           FontSize="22" FontWeight="Bold" Foreground="#9AA0A6"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="本机节点名称：在「注册中心」页填写“节点名称”后显示在这里（也是其他节点上自动生成的链路名）"/>

                <TextBlock Grid.Column="2" x:Name="NodeNameNote" Margin="12,0,0,2"
                           Foreground="#5F6368" VerticalAlignment="Bottom"
                           Text="在「注册中心」页填写“节点名称”后显示在这里"/>
            </Grid>
        </Border>

        <!-- ===== 运行参数 ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="本地监听端口"/>
                    <TextBox   Grid.Column="1" x:Name="ListenPortBox" Style="{StaticResource FieldBox}" Margin="0,0,22,0"
                               ToolTip="本机 TCP/UDP 监听端口（双栈：IPv4 与 IPv6 同时应答）"/>

                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="测试间隔(ms)"/>
                    <TextBox   Grid.Column="3" x:Name="IntervalBox" Style="{StaticResource FieldBox}" Margin="0,0,22,0"
                               ToolTip="主动探测轮次间隔，最小 50"/>

                    <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="单次超时(ms)"/>
                    <TextBox   Grid.Column="5" x:Name="TimeoutBox" Style="{StaticResource FieldBox}" Margin="0,0,22,0"
                               ToolTip="一次探测等待对端回包的最大时间，超过即判定超时/丢包"/>

                    <TextBlock Grid.Column="6" Style="{StaticResource FieldLabel}" Text="统计窗口(分钟)"/>
                    <TextBox   Grid.Column="7" x:Name="WindowBox" Style="{StaticResource FieldBox}"
                               ToolTip="实时统计的滑动时间窗口"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="异常RTT阈值(ms)"/>
                    <TextBox   Grid.Column="1" x:Name="WarningBox" Style="{StaticResource FieldBox}" Margin="0,0,22,0"
                               ToolTip="窗口内平均 RTT 达到该值即判定为“高延迟”"/>

                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="丢包率告警(%)"/>
                    <TextBox   Grid.Column="3" x:Name="LossWarnBox" Style="{StaticResource FieldBox}" Margin="0,0,22,0"
                               ToolTip="统计窗口内丢包率达到该百分比才判定为“有丢包”，避免历史上出现一次丢包就长期报警"/>

                    <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="连续丢包告警(次)"/>
                    <TextBox   Grid.Column="5" x:Name="LossCountBox" Style="{StaticResource FieldBox}" Margin="0,0,22,0"
                               ToolTip="连续丢包达到该次数即判定为“中断”"/>

                    <TextBlock Grid.Column="6" Style="{StaticResource FieldLabel}" Text="协议测试(总开关)"
                               ToolTip="总开关：只有这里勾选的协议才会发包。取消勾选的协议，即使链路自己勾了也不会发（两者取交集，总开关只能收紧、不能放宽）"/>
                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="TcpCheck" Style="{StaticResource FieldCheck}" Content="TCP" IsChecked="True"
                                  ToolTip="TCP 总开关：取消勾选立即停止所有链路的 TCP 探测（无需重启测试）。链路自身未勾 TCP 的，勾了这里也不会发"/>
                        <CheckBox x:Name="UdpCheck" Style="{StaticResource FieldCheck}" Content="UDP" IsChecked="True"
                                  Margin="0"
                                  ToolTip="UDP 总开关：取消勾选立即停止所有链路的 UDP 探测（无需重启测试）。链路自身未勾 UDP 的，勾了这里也不会发"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== 操作按钮 ===== -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="启动测试" Click="Start_Click" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"
                        ToolTip="按界面参数开始监听与探测；会清空界面统计，重新开始统计"/>
                <Button Content="停止测试" Click="Stop_Click" Margin="0,0,8,0"
                        ToolTip="停止监听与探测，界面保留已统计到的数据"/>
                <Button x:Name="ClearButton" Content="清除" Click="Clear_Click" Margin="0,0,8,0"
                        ToolTip="清空界面上的统计数据与异常/明细记录，并从当前时刻重新开始统计。运行中可反复点击；不影响监听与探测，也不会删除 logs 目录下的历史日志。"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="保存配置" Click="SaveConfig_Click" Margin="0,0,8,0"
                        ToolTip="把界面参数写回 appsettings.json"/>
                <Button Content="打开配置文件" Click="OpenConfig_Click"
                        ToolTip="用系统默认程序打开 appsettings.json"/>
            </StackPanel>
        </Grid>

        <!-- ===== 状态 ===== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatusDot" Grid.Column="0" Width="10" Height="10"
                             Fill="#9AA0A6" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="已停止"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusParams" Grid.Column="2" Foreground="#5F6368"
                               VerticalAlignment="Center" Margin="18,0,12,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusSamples" Grid.Column="3" Foreground="#202124"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="StatusNote" Margin="19,5,0,0" Foreground="#5F6368"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- ===== 数据表格 ===== -->
        <TabControl Grid.Row="4" x:Name="MainTabs" Margin="0,10,0,0" Background="Transparent" BorderThickness="0">
            <TabItem Header="链路实时统计">
                <DataGrid x:Name="StatsGrid" Margin="0,6,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="链路" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="170"/>
                        <DataGridTextColumn Header="平均RTT" Binding="{Binding Avg}" Width="92"
                                            ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                        <DataGridTextColumn Header="P50" Binding="{Binding P50}" Width="82"
                                            ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                        <DataGridTextColumn Header="P95" Binding="{Binding P95}" Width="82"
                                            ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                        <DataGridTextColumn Header="P99" Binding="{Binding P99}" Width="82"
                                            ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                        <DataGridTextColumn Header="发送" Binding="{Binding Sent}" Width="70"
                                            ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                        <DataGridTextColumn Header="丢包" Binding="{Binding Lost}" Width="70"
                                            ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                        <DataGridTextColumn Header="丢包率" Binding="{Binding LossRate}" Width="82"
                                            ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                        <DataGridTextColumn Header="连续丢包" Binding="{Binding ConsecutiveLoss}" Width="92"
                                            ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="失败原因" Binding="{Binding LastFailure}" Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding LastFailure}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="对端看到的本端地址" Binding="{Binding SeenFrom}"
                                            Width="*" MinWidth="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="异常记录（本会话）">
                <DataGrid x:Name="AnomalyGrid" Margin="0,6,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Seq}" Width="72"
                                            ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                        <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="172"/>
                        <DataGridTextColumn Header="链路" Binding="{Binding LinkName}" Width="150"/>
                        <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="160"/>
                        <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="70"/>
                        <DataGridTextColumn Header="RTT(ms)" Binding="{Binding RttText}" Width="92"
                                            ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                        <DataGridTextColumn Header="建连/解析(ms)" Binding="{Binding SetupText}" Width="112"
                                            ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                        <DataGridTextColumn Header="对端看到的源地址" Binding="{Binding SeenFromText}" Width="180"/>
                        <DataGridTextColumn Header="结果" Binding="{Binding Info}" Width="*" MinWidth="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Info}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="实时RTT明细">
                <DataGrid x:Name="TrendGrid" Margin="0,6,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Seq}" Width="72"
                                            ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                        <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="172"/>
                        <DataGridTextColumn Header="链路" Binding="{Binding LinkName}" Width="150"/>
                        <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="160"/>
                        <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="70"/>
                        <DataGridTextColumn Header="RTT(ms)" Binding="{Binding RttText}" Width="92"
                                            ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                        <DataGridTextColumn Header="探测ID" Binding="{Binding ProbeId}" Width="260"/>
                        <DataGridTextColumn Header="对端看到的源地址" Binding="{Binding SeenFromText}" Width="180"/>
                        <DataGridTextColumn Header="结果" Binding="{Binding Info}" Width="*" MinWidth="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Info}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="LinkTab" Header="链路配置">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="新增链路" Click="AddLink_Click" Margin="0,0,8,0"
                                ToolTip="新增一行；如果当前选中了某条链路，则以它为模板"/>
                        <Button Content="复制所选" Click="DuplicateLink_Click" Margin="0,0,8,0"
                                ToolTip="把选中的链路复制成新的一行"/>
                        <Button Content="删除所选" Click="DeleteLink_Click" Margin="0,0,8,0"
                                ToolTip="删除选中的链路（会先确认；可撤销）"/>
                        <Button x:Name="UndoDeleteButton" Content="撤销删除" Click="UndoDelete_Click"
                                IsEnabled="False" Margin="0,0,8,0"
                                ToolTip="恢复最近一次删除的链路"/>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#5F6368"
                                   Text="链路改动在点“启动测试”后生效（不会影响历史日志）"/>
                    </StackPanel>

                    <DataGrid x:Name="LinksGrid" Grid.Row="1" IsReadOnly="False"
                              SelectionMode="Extended"
                              BeginningEdit="LinksGrid_BeginningEdit"
                              ToolTip="直接双击单元格编辑；名称、主机/IP、端口都会实时校验。TCP 与 UDP 都不勾选表示这条链路不主动探测（对端是纯服务端，或临时停测而不想删掉配置）。来源为“注册中心”的链路由中心自动维护，名称/主机/端口只读">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <!-- 顺序有意义：校验失败的红字放在后面，避免被"注册链路"的颜色盖掉 -->
                                    <DataTrigger Binding="{Binding IsRegistry}" Value="True">
                                        <Setter Property="Foreground" Value="#463C8A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter Property="Background" Value="#FDECEA"/>
                                        <Setter Property="Foreground" Value="#B3261E"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Width="170"/>
                            <DataGridTextColumn Header="主机 / IP"
                                                Binding="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                                Width="200"/>
                            <DataGridTextColumn Header="端口"
                                                Binding="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                                Width="90"
                                                ElementStyle="{StaticResource NumberCell}"
                                                HeaderStyle="{StaticResource NumberHeader}"/>
                            <DataGridCheckBoxColumn Header="TCP"
                                                    Binding="{Binding Tcp, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="60"/>
                            <DataGridCheckBoxColumn Header="UDP"
                                                    Binding="{Binding Udp, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="60"/>
                            <DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="80"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="生效（实际发包）" Binding="{Binding Effective}" Width="130"
                                                IsReadOnly="True"
                                                HeaderStyle="{StaticResource NumberHeader}"
                                                ElementStyle="{StaticResource NumberCell}"/>
                            <DataGridTextColumn Header="校验" Binding="{Binding Diagnosis}" Width="*"
                                                MinWidth="200" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="LinkSummary" Grid.Row="2" Margin="2,8,0,0"
                               Foreground="#5F6368" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="RegistryTab" Header="注册中心">
                <views:RegistryPanel x:Name="RegistryTabPanel"/>
            </TabItem>
        </TabControl>

        <!-- ===== 说明（默认折叠，把纵向空间让给表格） ===== -->
        <Expander Grid.Row="5" Header="说明 / 配置文件 / 指标口径" Margin="0,10,0,0"
                  Padding="0" IsExpanded="False" Foreground="#3C4043">
            <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                <TextBlock Margin="2" TextWrapping="Wrap" Foreground="#3C4043" LineHeight="20">
                    所有运行参数统一从<Bold>程序目录</Bold> appsettings.json 加载（即 EXE 所在目录，“打开配置文件”可直达）。
                    界面修改参数后点击“保存配置”写回文件；“启动测试”会先把界面参数写回文件，再按该配置开始监听与探测。
                    若配置文件在程序运行期间被其它程序修改，点击“启动测试/保存配置”时会提示选择：重新加载文件，或用界面值覆盖。
                    <LineBreak/>
                    <Bold>协议勾选</Bold>：只有勾选的协议才会发出探测包，取消勾选后<Bold>立即生效</Bold>（无需重启测试），该协议的链路随即停止发包；
                    它需要与链路自身的 Tcp/Udp 同时为真。取消勾选不会删除已经统计到的数据。
                    把某条链路的 TCP 与 UDP 都取消勾选，就等于「只保留配置、不主动探测」这条链路（对方可能是纯服务端）。
                    <LineBreak/>
                    <Bold>清除</Bold>：只清空界面上的统计数据、异常记录与明细，并从当前时刻重新开始统计，运行中可反复点击；它不会停止监听与探测，也不会删除 logs 目录下的历史日志。
                    <LineBreak/>
                    <Bold>RTT 口径</Bold>：从发出首个探测字节到收齐对端回包（不含 DNS 解析与 TCP 建连），因此 TCP 与 UDP 两行可直接比较；建连与解析耗时单独记录在“建连/解析(ms)”列与日志的 setup_ms 字段。
                    <LineBreak/>
                    <Bold>探测包内容</Bold>为“序号|探测ID|v2”：序号按链路+协议从 1 开始单调递增，运行期间不清零，界面详单、CSV 日志与抓包可按序号对齐；序号跳号表示该次探测结果未被记录（停止/清除时丢弃），真正的丢包会照常记为一行 packet_loss=1。
                    <LineBreak/>
                    <Bold>对端看到的源地址</Bold>：探测包末尾带 v2 标记时，被动端会把“它看到的你的源地址（ip:端口）”附加在回包里，界面与日志都会记录（列名 seen_from）。跨公网时这就是你的出口公网 IP 与 NAT 后的源端口；如果它会随时间变化，说明出口做了多线路负载均衡或运营商 NAT 池。对端是修复前的老版本时不带这个字段（不影响探测）。
                    <Bold>失败原因</Bold>：丢包不再只有一句话。「无响应（超时）」表示包在到达监听者之前被丢弃（查端口映射 / ACL / 防火墙 / 运营商）；
                    「连接被拒绝（端口无监听）」表示网络路径是通的、只是该端口没有程序在监听；UDP 收到 ICMP 则会显示「UDP 端口不可达（收到 ICMP）」。逐条记在 CSV 的 failure 列。
                    <LineBreak/>
                    链路历史日志按天分目录保存：<Bold>logs\YYYY-MM-DD\&lt;链路&gt;_&lt;IP&gt;_&lt;端口&gt;.csv</Bold>（跨零点自动换新目录，同一天内追加）。
                    重启测试不会删除历史日志，工具也不会自动清理日志（需要按天数保留可以配置）。
                </TextBlock>
            </Border>
        </Expander>
    </Grid>
</Window>
